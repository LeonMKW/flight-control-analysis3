COMMON: &common
  DEBUG: False

  # 遥测数据库
  INFLUXDB_HOST: grafana-dashboards
  INFLUXDB_HOST_OUTPUT: grafana-dashboards
  INFLUXDB_PORT: 8086
  INFLUXDB_USER: admin
  INFLUXDB_PASSWD:
  INFLUXDB_DB_INPUT: measure
  INFLUXDB_DB_ACTION: action
  INFLUXDB_DB_CHRONOGRAF:
  INFLUXDB_DB_ORBITDATA:
  # 日志配置文件路径
  LOGGING_CONFIG_PATH: ./config/logging.yaml
  # 日志文件存放位置
  LOGGING_PATH: ./logs
  #  GraphQL
  METE_DATA: http://ttnonc-frontend-bff
  ORBIT_SERVICE: http://ttnonc-frontend-bff

  MONGO_HOST1: mongodb-cluster-0.mongodb-cluster-svc.cyk3.svc.cluster.local
  MONGO_HOST2: mongodb-cluster-1.mongodb-cluster-svc.cyk3.svc.cluster.local
  MONGO_HOST3: mongodb-cluster-2.mongodb-cluster-svc.cyk3.svc.cluster.local
  MONGO_PORT1: 27017
  MONGO_PORT2: 27017
  MONGO_PORT3: 27017
  MONGO_HOSTS:
    - mongodb-cluster-0.mongodb-cluster-svc.cyk3.svc.cluster.local:27017
    - mongodb-cluster-1.mongodb-cluster-svc.cyk3.svc.cluster.local:27017
    - mongodb-cluster-2.mongodb-cluster-svc.cyk3.svc.cluster.local:27017
  MONGO_AUTH_SOURCE: 'admin'
  MONGO_INITDB_ROOT_USERNAME: 'flight-control'
  MONGO_INITDB_ROOT_PASSWORD: 'flight-control'

  #Notification Service
  NOTIFICATION_URL: http://ttnonc-event-handler-service.cyk3/event/handler/push-data

  #ORBIT_PROPAGATION
  ORBIT_PROPAGATION: http://ttnonc-frontend-bff

  #ORBIT MANEUVER
  ORBIT_MANEUVER: http://ttnonc-frontend-bff/v2/api/openapi-transform/orbit-fire-period

  #POST SATELLITE REPORT SEARCH
  POST_SATELLITE_REPORT_SEARCH: http://spacecraft-info-report.prod.yhroot.com/satellite-report-info/search

  #GET SATELLITE FILE DOWNLOAD
  GET_SATELLITE_FILE_DOWNLOAD: http://satellite-file-service.prod.yhroot.com/satellite-file/download?

  #MariaDB
  MARIADB_HOST:
  MARIADB_PORT: 3306
  MARIADB_ODDBNAME:
  MARIADB_USER:
  MARIADB_PASSWORD:

  #OSS config
  OSS2_ENDPOINT: 'http://oss-cn-beijing.aliyuncs.com'
  OSS2_ACCESS:
  OSS2_SECRET:
  OSS2_BUCKET:

  #Gateway task
  APPLICATION_TASK: http://ttnonc-frontend-bff/v2/api/openapi-transform/get-all-application-task

  #HTTP POST TOKEN URL
  POST_TOKEN_URL: http://ttnonc-frontend-bff/v2/api/openapi/get-token
  POST_TOKEN_USERNAME: 'report@yinhe.ht'
  POST_TOKEN_PASSWORD: '123456'

  #ODPA3.0 URL
  ODPA3_URL: http://odpa3.cyk3.yhroot.com

  #DSR1:14B API
  DSR1_URL:
  DSR1_TOKEN: app-

